PORT=4318
HOST=127.0.0.1
WEB_PORT=4319
DATA_DIR=./data
TRUSTED_ORIGINS=http://localhost:4319,http://127.0.0.1:4319,http://localhost:4318,http://127.0.0.1:4318
# 公网 HTTPS 部署时设置为实际域名，并开启安全 Cookie。
SECURE_COOKIE=false
# 真实底图用 JS Key（配置域名限制）；POI 查询用 WebService Key。不要公开 Key/SK。
WEFOOD_TENCENT_JS_KEY=
WEFOOD_TENCENT_KEY=
WEFOOD_TENCENT_SK=
WEFOOD_MAPS_DAILY_LIMIT=100
WEFOOD_MAPS_USER_DAILY_LIMIT=20
# 线上配置应写入 N150 ~/wefood/.env；高德需要 Web 服务 Key，不能用 JS Key。
WEFOOD_AMAP_KEY=
WEFOOD_DISH_DAILY_LIMIT=100
WEFOOD_DISH_USER_DAILY_LIMIT=20
